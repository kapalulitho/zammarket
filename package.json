{
  "name": "zamnexus",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "npm run build && wrangler dev",
    "test": "node --test",
    "dev:staging": "node scripts/check-staging.mjs --require-config && vite --mode staging --host 127.0.0.1 --port 5180 --strictPort",
    "build:staging": "node scripts/check-staging.mjs --require-config && vite build --mode staging",
    "check:staging": "node scripts/check-staging.mjs",
    "prepare:staging": "node scripts/prepare-staging.mjs",
    "check:staging:remote": "node scripts/check-staging-remote.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "vite": "^8.3.0",
    "wrangler": "^4.162.0"
  }
}
